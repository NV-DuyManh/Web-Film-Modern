const fs = require('fs');
const transcriptPath = 'C:/Users/Admin/.gemini/antigravity-ide/brain/10d436c9-3db6-4be3-a843-f46bb905288d/.system_generated/logs/transcript_full.jsonl';
const lines = fs.readFileSync(transcriptPath, 'utf-8').split('\
');
let fullOutput = '';
for (let l of lines) {
    if (!l) continue;
    try {
        let j = JSON.parse(l);
        if (j.type === 'TOOL_RESPONSE' && j.tool_name === 'run_command' && j.tool_response && j.tool_response.output) {
            let out = j.tool_response.output;
            if (out.includes('diff --git a/src/App.scss') && out.includes('modal-actions-danger')) {
                fullOutput = out;
            }
        }
    } catch(e) {}
}
if (fullOutput) {
    // Write just the patch part
    let diffStart = fullOutput.indexOf('diff --git');
    if (diffStart !== -1) {
        fs.writeFileSync('recover.patch', fullOutput.substring(diffStart));
        console.log('Successfully recovered patch!');
    }
}

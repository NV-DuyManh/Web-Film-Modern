TYPE kafka
KAFKA_BOOTSTRAP_SERVERS mfilm-kafka-mfilm-bigdata.f.aivencloud.com:14043
KAFKA_SECURITY_PROTOCOL SASL_SSL
KAFKA_SASL_MECHANISM SCRAM-SHA-256
KAFKA_KEY {{ tb_secret("MFILM_KAFKA_KEY", "") }}
KAFKA_SECRET {{ tb_secret("MFILM_KAFKA_SECRET", "") }}

KAFKA_SSL_CA_PEM >
  {{ tb_secret("MFILM_KAFKA_CA_PEM") }}

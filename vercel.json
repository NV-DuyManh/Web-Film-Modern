{
  "functions": {
    "api/page.js": {
      "includeFiles": "{dist/index.html,server/seo/catalog.json}"
    },
    "api/public-catalog.js": {
      "includeFiles": "server/seo/catalog.json"
    },
    "api/sitemap.js": {
      "includeFiles": "{public/sitemap.xml,server/seo/catalog.json}"
    }
  },
  "routes": [
    {
      "src": "/sitemap.xml",
      "dest": "/api/sitemap"
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/(?:index\\.html|app-recovery\\.js|sw\\.js)",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "/((?!api(?:/|$)|assets(?:/|$)|.*\\.[^/]+$).*)",
      "dest": "/api/page?path=/$1",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "status": 404
    }
  ]
}
